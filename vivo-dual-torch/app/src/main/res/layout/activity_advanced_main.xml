<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="22dp"
        android:paddingEnd="20dp"
        android:paddingBottom="34dp">

        <!-- 头部 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="‹ 返回"
                android:textColor="@color/text_dim"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.04"
                    android:text="高级选项"
                    android:textColor="@color/text"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:letterSpacing="0.18"
                    android:text="驱动 · 会话 · 频闪 · 工具"
                    android:textColor="@color/text_faint"
                    android:textSize="8.5sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 策略 -->
        <TextView
            style="@style/Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="驱 动 策 略" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipAuto"
                    style="@style/Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="自动" />

                <TextView
                    android:id="@+id/chipSystem"
                    style="@style/Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="系统手电" />

                <TextView
                    android:id="@+id/chipCamera"
                    style="@style/Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="相机会话" />

                <TextView
                    android:id="@+id/chipVendor"
                    style="@style/Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Vendor" />

                <TextView
                    android:id="@+id/chipRoot"
                    style="@style/Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Root" />
            </LinearLayout>
        </HorizontalScrollView>

        <TextView
            android:id="@+id/tvModeHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:layout_marginStart="4dp"
            android:text=""
            android:textColor="@color/text_dim"
            android:textSize="10sp"
            android:lineSpacingExtra="3dp" />

        <!-- 会话参数 -->
        <TextView
            style="@style/Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="会 话 参 数" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="会话相机"
                    android:textColor="@color/text"
                    android:textSize="12.5sp" />

                <TextView
                    android:id="@+id/chipCamAuto"
                    style="@style/Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="自动" />

                <TextView
                    android:id="@+id/chipCamA"
                    style="@style/Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="主摄" />

                <TextView
                    android:id="@+id/chipCamTele"
                    style="@style/Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="0dp"
                    android:text="长焦" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="闪光方式"
                android:textColor="@color/text"
                android:textSize="12.5sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipFlashTorch"
                    style="@style/Chip"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="TORCH" />

                <TextView
                    android:id="@+id/chipFlashAlways"
                    style="@style/Chip"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="ALWAYS" />

                <TextView
                    android:id="@+id/chipFlashBoth"
                    style="@style/Chip"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="0dp"
                    android:layout_weight="1"
                    android:text="TORCH+AE" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="频闪 / 信号"
                android:textColor="@color/text"
                android:textSize="12.5sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipStrobeOff"
                    style="@style/Chip"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="常亮" />

                <TextView
                    android:id="@+id/chipStrobe2"
                    style="@style/Chip"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="2Hz" />

                <TextView
                    android:id="@+id/chipStrobe5"
                    style="@style/Chip"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="5Hz" />

                <TextView
                    android:id="@+id/chipStrobe10"
                    style="@style/Chip"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="10Hz" />

                <TextView
                    android:id="@+id/chipSos"
                    style="@style/Chip"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="0dp"
                    android:layout_weight="1"
                    android:text="SOS" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="厂商参数注入（Vendor 策略）"
                android:textColor="@color/text"
                android:textSize="12.5sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etVendorKey"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1.5"
                    android:backgroundTint="@color/stroke"
                    android:hint="com.vivo.flash.mode"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:singleLine="true"
                    android:textColor="@color/text"
                    android:textColorHint="#4C5566"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/etVendorValue"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="0.7"
                    android:backgroundTint="@color/stroke"
                    android:hint="值"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:singleLine="true"
                    android:textColor="@color/text"
                    android:textColorHint="#4C5566"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/btnApplyVendor"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_btn_ghost"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="注入"
                    android:textColor="@color/accent"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 系统入口 -->
        <TextView
            style="@style/Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="系 统 入 口" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="3dp"
                android:text="控制中心磁贴、桌面快捷方式、「快捷启动 / 轻敲背面 → 打开应用」都按主界面的焦段与亮度开灯。"
                android:textColor="@color/text_dim"
                android:textSize="10.5sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:lineSpacingExtra="2dp"
                    android:text="打开应用即开双灯\n长按音量下键 / 敲击背面 → 打开本应用 → 直接两颗全亮"
                    android:textColor="@color/text"
                    android:textSize="12.5sp" />

                <Switch
                    android:id="@+id/swAutoOn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnAddTile"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_btn_ghost"
                android:gravity="center"
                android:text="添加控制中心磁贴"
                android:textColor="@color/text"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/btnGuide"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_btn_ghost"
                android:gravity="center"
                android:text="绑定步骤：哪些入口能接第三方"
                android:textColor="@color/text"
                android:textSize="12.5sp" />
        </LinearLayout>

        <!-- 关于与更新 -->
        <TextView
            style="@style/Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="关 于 与 更 新" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvAboutVersion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="双芯闪光灯 v1.0.1"
                android:textColor="@color/text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="2dp"
                android:text="作者 HWX_Xuan · github.com/HWX-Xuan/DualTorch-forVivo"
                android:textColor="@color/text_dim"
                android:textSize="10.5sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:lineSpacingExtra="2dp"
                    android:text="自动检查更新\n启动时静默检查，有新版本再提示"
                    android:textColor="@color/text"
                    android:textSize="12.5sp" />

                <Switch
                    android:id="@+id/swAutoUpdate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnCheckUpdate"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_btn_ghost"
                android:gravity="center"
                android:text="检查更新"
                android:textColor="@color/text"
                android:textSize="12.5sp" />
        </LinearLayout>

        <!-- 日志 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="调 试 日 志"
                android:textColor="@color/text_dim"
                android:textSize="10sp"
                android:letterSpacing="0.12" />

            <TextView
                android:id="@+id/btnCopyLog"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="6dp"
                android:text="复制"
                android:textColor="@color/blue"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_log"
            android:fontFamily="monospace"
            android:lineSpacingExtra="2dp"
            android:padding="12dp"
            android:scrollbars="vertical"
            android:textColor="#9FB2C8"
            android:textSize="9.5sp" />

        <!-- 工具入口 -->
        <TextView
            style="@style/Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="工 具" />

        <TextView
            android:id="@+id/btnLab"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_btn_ghost"
            android:gravity="center"
            android:text="物理子相机 / 单次闪光实验  ›"
            android:textColor="@color/text"
            android:textSize="12.5sp" />

        <TextView
            android:id="@+id/btnProbe"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="9dp"
            android:background="@drawable/bg_btn_ghost"
            android:gravity="center"
            android:text="硬件探测：相机表 / 厂商键  ›"
            android:textColor="@color/text"
            android:textSize="12.5sp" />

        <TextView
            android:id="@+id/btnScan"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="9dp"
            android:background="@drawable/bg_btn_ghost"
            android:gravity="center"
            android:text="逐路自检：每个 cameraId 单独点  ›"
            android:textColor="@color/text"
            android:textSize="12.5sp" />

        <TextView
            android:id="@+id/btnRoot"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="9dp"
            android:background="@drawable/bg_btn_ghost"
            android:gravity="center"
            android:text="Root 直控 LED 节点  ›"
            android:textColor="@color/text"
            android:textSize="12.5sp" />
    </LinearLayout>
</ScrollView>
