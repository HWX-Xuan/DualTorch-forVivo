<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="30dp">

        <!-- ============ 头部 ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.01"
                    android:text="双芯闪光灯"
                    android:textColor="@color/text"
                    android:textSize="25sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:letterSpacing="0.26"
                    android:text="DUAL · LED · TORCH"
                    android:textColor="@color/accent"
                    android:textSize="8sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnAdvanced"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:letterSpacing="0.06"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:text="高级 ›"
                android:textColor="@color/accent"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ============ 状态 ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:background="@drawable/bg_dot" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="已关闭"
                android:textColor="@color/text"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/tvStrategy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/text_faint"
                android:textSize="9.5sp" />
        </LinearLayout>

        <!-- ============ 主开关 ============ -->
        <LinearLayout
            android:id="@+id/btnMaster"
            android:layout_width="match_parent"
            android:layout_height="168dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_power_off"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvMasterTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.1"
                android:text="开灯"
                android:textColor="@color/text"
                android:textSize="31sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvMasterSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:letterSpacing="0.04"
                android:text="广角 · 最亮"
                android:textColor="@color/text_dim"
                android:textSize="11.5sp" />
        </LinearLayout>

        <!-- ============ 灯路 ============ -->
        <TextView
            style="@style/Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="灯 路" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tileWide"
                style="@style/FocalTile"
                android:layout_width="0dp"
                android:layout_height="74dp"
                android:layout_marginEnd="9dp"
                android:layout_weight="1"
                android:text="广角" />

            <TextView
                android:id="@+id/tileDual"
                style="@style/FocalTile"
                android:layout_width="0dp"
                android:layout_height="74dp"
                android:layout_weight="1"
                android:text="双灯" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvFocalHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="3dp"
            android:text=""
            android:textColor="@color/text_faint"
            android:textSize="10sp" />

        <!-- ============ 亮度 ============ -->
        <TextView
            style="@style/Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="亮 度" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="16dp"
            android:paddingEnd="18dp"
            android:paddingBottom="15dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:letterSpacing="0.02"
                    android:text="输出亮度"
                    android:textColor="@color/text"
                    android:textSize="12.5sp" />

                <TextView
                    android:id="@+id/tvStrength"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="最亮"
                    android:textColor="@color/accent"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/sbStrength"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:layout_marginTop="10dp"
                android:max="4"
                android:min="0"
                android:paddingStart="9dp"
                android:paddingEnd="9dp"
                android:progress="4"
                android:progressDrawable="@drawable/seek_track"
                android:splitTrack="false"
                android:thumb="@drawable/seek_thumb" />

            <LinearLayout
                android:id="@+id/tickRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:orientation="horizontal"
                android:paddingStart="9dp"
                android:paddingEnd="9dp" />

            <TextView
                android:id="@+id/tvStrengthHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:lineSpacingExtra="3dp"
                android:text=""
                android:textColor="@color/text_faint"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- ============ 快捷提示 ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="15dp"
            android:paddingTop="13dp"
            android:paddingEnd="15dp"
            android:paddingBottom="13dp">

            <View
                android:layout_width="3dp"
                android:layout_height="26dp"
                android:background="@drawable/bg_bar" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:lineSpacingExtra="3dp"
                android:text="长按音量下键 / 敲击背面打开本应用，会直接点亮两颗灯，不用再点。"
                android:textColor="@color/text_dim"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
